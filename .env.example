# Copy to .env and fill in what you need: `cp .env.example .env`
#
# .env is gitignored and read from the working directory when you run `rootlogic`.
# An exported variable always wins over this file, so a one-off
# `TAVILY_API_KEY=... rootlogic research ...` still does what it says.
# Needs the extra: pip install -e '.[env]'
#
# A running server keeps the environment it started with: restart it after editing this file.

# --- the model ----------------------------------------------------------------
# Claude directly (default provider). Also `ant auth login` if you use the CLI.
ANTHROPIC_API_KEY=sk-ant-...

# An OpenAI-compatible endpoint instead (--provider openai): OpenAI, OpenRouter,
# a local Ollama, or a gateway. This is the key that endpoint wants, whoever issues it.
# Note: if it is not a key for OpenAI's own API, moderation cannot use it and the run
# refuses to start unless you pass --moderation none or --moderation llama-guard.
OPENAI_API_KEY=sk-...

# --- search -------------------------------------------------------------------
# Needed for --search tavily. Billed by Tavily, not shown in `rootlogic usage`.
TAVILY_API_KEY=tvly-...

# --- tracing (optional) -------------------------------------------------------
# Both keys must be set before any tracing happens. LANGFUSE_HOST is required for
# self-hosted instances; without it the SDK talks to Langfuse's EU cloud.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# --- storage (optional) -------------------------------------------------------
# Where sessions, reports and checkpoints live. Defaults to ./.rootlogic
# ROOTLOGIC_HOME=.rootlogic
